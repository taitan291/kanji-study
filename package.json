{
  "name": "kanji",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run fetch:data && vite",
    "build": "npm run fetch:data && npm run validate:questions && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:questions": "tsx scripts/validate-questions.ts",
    "fetch:data": "tsx scripts/fetch-questions.ts",
    "pages:dev": "npm run build && wrangler pages dev dist"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@material-symbols/svg-400": "^0.49.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.163.0"
  },
  "dependencies": {
    "idb": "^8.0.4"
  }
}
